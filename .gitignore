# ==========================================================
# GPDI - .gitignore racine (backend Spring Boot + frontend Angular)
# ==========================================================

# ---------- Secrets / variables d'environnement ----------
.env
.env.*
!.env.example

# ---------- Backend (Maven / Spring Boot) ----------
backend/target/
backend/HELP.md
backend/.mvn/wrapper/maven-wrapper.jar
backend/out.log
!**/src/main/**/target/
!**/src/test/**/target/

# STS / Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ---------- Frontend (Angular / Node) ----------
frontend/node_modules/
frontend/dist/
frontend/tmp/
frontend/out-tsc/
frontend/bazel-out/
frontend/.angular/cache/
frontend/coverage/
frontend/typings/
frontend/connect.lock
frontend/libpeerconnection.log
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
testem.log
.sass-cache/
__screenshots__/

# ---------- IDE / éditeurs ----------
.idea/
*.iws
*.iml
*.ipr
.c9/
*.launch
*.sublime-workspace
.history/

# VS Code : ignoré dans le backend (comme son .gitignore d'origine)
backend/.vscode/
# VS Code : seuls les fichiers partagés du frontend sont gardés
frontend/.vscode/*
!frontend/.vscode/settings.json
!frontend/.vscode/tasks.json
!frontend/.vscode/launch.json
!frontend/.vscode/extensions.json
!frontend/.vscode/mcp.json

# ---------- Outils IA / assistants (configs locales) ----------
.claude/
.cursor/
.gemini/
CLAUDE.md
frontend/.github/

# ---------- Scripts locaux ----------
get-token.ps1
run.ps1
del59.svg
.github/modernize/
backend/.github/modernize/

# ---------- Logs ----------
*.log
logs/

# ---------- Fichiers système ----------
.DS_Store
Thumbs.db
desktop.ini
.gitignore
